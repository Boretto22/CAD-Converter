include plugin.json requirements*.txt THIRD_PARTY_NOTICES.md CHANGELOG.md CONTRIBUTING.md
recursive-include skills *.md *.txt *.py
recursive-include docs *.md *.json
recursive-include examples *.json *.txt *.png *.pdf *.dxf *.step *.py *.md
recursive-include tests *.py
recursive-include tools *.py
recursive-include .github *.yml
global-exclude *.pyc
global-exclude __pycache__
